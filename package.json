{
  "name": "projet_clean_archi_5iwj",
  "version": "1.0.0",
  "description": "ESGI projet for class clean architecure, create EcoEATS a platform for food delivery",
  "license": "ISC",
  "author": "Grondin Florent, SANKARE Jordan",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node -r tsconfig-paths/register src/infrastructure/frameworks/express/index.ts",
    "dev:postgres": "DB_ADAPTER=postgres nodemon --watch src --ext ts --exec ts-node -r tsconfig-paths/register src/infrastructure/frameworks/express/index.ts",
    "setup": "npm run dev",
    "setup:postgres": "docker compose up -d && npm run db:migrate && npm run dev:postgres",
    "build": "tsc && tsc-alias",
    "start": "npm run build && node dist/infrastructure/frameworks/express/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.4.2",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.9",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/morgan": "^1.9.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "ts-node": "^10.9.2"
  }
}
