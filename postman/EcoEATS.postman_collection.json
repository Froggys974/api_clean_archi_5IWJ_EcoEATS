        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 - OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has token', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('token');",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('jwt_token', json.token);",
                  "  pm.collectionVariables.set('jwt_token', json.token);",
                  "  console.log('JWT token saved:', json.token.substring(0, 30) + '...');",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client@test.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Connexion d'un utilisateur existant (CLIENT ou COURIER).\n\nLe script de test sauvegarde automatiquement le token JWT dans la variable d'environnement `jwt_token` pour les prochaines requêtes.\n\n**Corps requis** :\n- `email` (string) — adresse email\n- `password` (string) — mot de passe\n\n**Réponses** :\n- `200` — Connexion réussie, retourne `{ token }`\n- `401` — Identifiants invalides"
          },
