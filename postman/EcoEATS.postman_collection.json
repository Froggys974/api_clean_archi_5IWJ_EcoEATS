                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client@test.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Florent\",\n  \"lastName\": \"Client\",\n  \"phone\": \"0612345678\"\n}",
              "options": {
                "raw": {
